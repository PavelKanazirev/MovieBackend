# Build output
/out/
/build/
/cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
compile_commands.json
CMakeUserPresets.json

# VS Code local/machine-specific overrides (tracked defaults live in .vscode/*.json below)
.vscode/*
!.vscode/settings.json
!.vscode/c_cpp_properties.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Compiler / linker artifacts
*.obj
*.o
*.pdb
*.ilk
*.exe
*.exp
*.lib
*.log

# Backup files
*.bak
