# MovieBackend static analysis configuration.
#
# Only enabled during a build when the "debug-clang-tidy" CMake preset (or
# -DMOVIEBACKEND_ENABLE_CLANG_TIDY=ON) is used, since it slows compilation down noticeably.
#
# The check groups below are a fairly standard "modern C++ best practices" baseline. A handful
# of the noisier/more opinionated checks are disabled so the tool stays useful rather than
# overwhelming while you're still getting comfortable with modern C++ idioms - feel free to
# tighten this over time as the codebase (and your familiarity with the checks) grows.
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -readability-identifier-length,
  -cppcoreguidelines-macro-usage

WarningsAsErrors: ''
# Anchored to /MovieBackend/(include|src)/ rather than the bare '(include|src)/.*' this used to
# be: that broader pattern matches ANY path containing an include/ or src/ component, which turns
# out to include every FetchContent'd dependency too (e.g. .../_deps/spdlog-src/include/...),
# since they happen to ship their own include/ directories. Confirmed by actually building with
# clang-tidy enabled before and after this change - the unanchored version produced dozens of
# warnings against spdlog's own headers, none of which are ours to fix.
# Assumes the checkout directory is named "MovieBackend" (true for a normal `git clone`); a
# differently-named checkout just means clang-tidy stops flagging our own headers too, not a
# safety issue, just a missed warning.
HeaderFilterRegex: '.*/MovieBackend/(include|src)/.*'
FormatStyle: file
